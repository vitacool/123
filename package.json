{
  "name": "framecut-editor",
  "private": true,
  "version": "1.0.0",
  "description": "FrameCut — a lightweight, embeddable, non-destructive browser video editor.",
  "type": "module",
  "main": "./dist-lib/framecut-editor.js",
  "module": "./dist-lib/framecut-editor.js",
  "types": "./src/editor/index.ts",
  "style": "./dist-lib/framecut-editor.css",
  "exports": {
    ".": {
      "types": "./src/editor/index.ts",
      "import": "./dist-lib/framecut-editor.js"
    },
    "./style.css": "./dist-lib/framecut-editor.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepare:ffmpeg": "node scripts/copy-ffmpeg-core.mjs",
    "prepare:asr": "node scripts/copy-asr-assets.mjs",
    "predev": "node scripts/copy-ffmpeg-core.mjs && node scripts/copy-asr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs && node scripts/copy-asr-assets.mjs",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -b && vite build --config vite.config.lib.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@huggingface/transformers": "^3.8.1",
    "opencc-js": "^1.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.5.33",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
