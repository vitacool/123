{
  "name": "framecut-editor",
  "private": true,
  "version": "1.0.0",
  "description": "FrameCut — a lightweight, embeddable, non-destructive browser video editor.",
  "type": "module",
  "main": "./dist-lib/framecut-editor.js",
  "module": "./dist-lib/framecut-editor.js",
  "types": "./dist-lib/index.d.ts",
  "style": "./dist-lib/framecut-editor.css",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/framecut-editor.js"
    },
    "./style.css": "./dist-lib/framecut-editor.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepare:ffmpeg": "node scripts/copy-ffmpeg-core.mjs",
    "prepare:asr": "node scripts/copy-asr-assets.mjs",
    "predev": "node scripts/copy-ffmpeg-core.mjs && node scripts/copy-asr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs && node scripts/copy-asr-assets.mjs",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -b && vite build --config vite.config.lib.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "lint:report": "eslint . --format json -o eslint-report.json",
    "pretest:e2e": "node scripts/make-test-fixture.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@huggingface/transformers": "^3.8.1",
    "opencc-js": "^1.4.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
